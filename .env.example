# Settings for all skills in this repository. Copy to .env (git-ignored) and fill in what you use.
# Scripts read the nearest .env from the current folder upwards, so this one file serves every skill and
# every example. In your own projects, put the same variables into that project's .env instead.
# Variables already set in the shell always win over the file.

# --- azure-devops  (details: skills/azure-devops/.env.example)
AZURE_DEVOPS_ORG=your-org
AZURE_DEVOPS_PROJECT=YourProject
# https://dev.azure.com/<org>/_usersSettings/tokens - read scopes: Code, Build, Work Items, Wiki, Agent Pools,
# Project and Team; add Code (Read & write) only for `pr-create --apply`. Empty = anonymous (public projects).
AZURE_DEVOPS_PAT=

# --- git-hosting (coming next); names as the gh / glab CLIs expect them
# GitHub: https://github.com/settings/tokens (scopes: repo, workflow)
GH_TOKEN=
# GitLab: <host>/-/user_settings/personal_access_tokens (scopes: read_api, read_repository)
GITLAB_HOST=https://gitlab.com
GITLAB_TOKEN=
