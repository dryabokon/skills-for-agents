# BigQuery settings for scripts/bq.py. Copy to .env (git-ignored) and fill in.
# bq.py reads .env from the current folder or any parent; variables already set in the shell win.
# Authentication is your gcloud sign-in: `gcloud auth login` (no key file needed).

# The project that runs - and pays for - queries (it can read public datasets of other projects).
GOOGLE_CLOUD_PROJECT=your-project-id
# Largest query bq.py will run, in GB scanned; BigQuery itself refuses to bill more.
BQ_MAX_GB=1
# Location of your jobs, for `bq.py costs` (US, EU, europe-west1, ...).
BQ_LOCATION=US
