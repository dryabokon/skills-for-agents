# Azure DevOps settings for scripts/ado.py. Copy to .env (git-ignored) and fill in.
# ado.py reads .env from the current folder or any parent; variables already set in the shell win.

# Organization: the part after https://dev.azure.com/
AZURE_DEVOPS_ORG=your-org
# ...or the full URL for old-style organizations:
# AZURE_DEVOPS_ORG_URL=https://your-org.visualstudio.com

AZURE_DEVOPS_PROJECT=YourProject

# Personal access token: https://dev.azure.com/<org>/_usersSettings/tokens
# Read-only use needs: Code (Read), Build (Read), Work Items (Read), Wiki (Read),
#                      Agent Pools (Read), Project and Team (Read).
# Add Code (Read & write) only if you want `pr-create --apply`.
# Public projects work without a token, except work items and agent pools.
AZURE_DEVOPS_PAT=
