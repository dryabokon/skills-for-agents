# Deploy settings for deploy.sh (copy to .env, which git ignores)
SERVICE=my-console
PROJECT=my-gcp-project
REGION=europe-west1
ACCOUNT=me@example.com
VIEWERS=user:me@example.com
# SECRETS=SOME_API_KEY          names of .env values to pass to the app through Secret Manager
# SOME_API_KEY=
# IAP_CLIENT_ID=                OAuth client for IAP (project outside an organization)
# IAP_CLIENT_SECRET=
